{
  "version": "2026-10-14",
  "presets": [
    {
      "id": "openai", "name": "OpenAI", "kind": "vendor",
      "console": "https://platform.openai.com/api-keys",
      "pricingUrl": "https://developers.openai.com/api/docs/pricing",
      "suggestedHeaders": ["OpenAI-Organization", "OpenAI-Project"],
      "note": "Responses 是 OpenAI 的主线协议；Chat Completions 仍受支持，但新模型和新功能优先出现在 Responses。",
      "routes": [
        { "id": "responses", "label": "Responses", "protocol": "openai-responses", "baseUrl": "https://api.openai.com/v1", "authMode": "bearer",
          "dialect": { "store": false, "outputCap": "max_output_tokens" }, "listModels": true },
        { "id": "chat", "label": "Chat Completions", "protocol": "openai-chat-completions", "baseUrl": "https://api.openai.com/v1", "authMode": "bearer",
          "dialect": { "outputCap": "max_completion_tokens", "streamUsage": true }, "listModels": true }
      ]
    },
    {
      "id": "anthropic", "name": "Anthropic", "kind": "vendor",
      "console": "https://platform.claude.com/settings/keys",
      "pricingUrl": "https://platform.claude.com/docs/en/about-claude/pricing",
      "suggestedHeaders": ["anthropic-beta"],
      "note": "Claude 5 系列默认自适应思考；部分模型不接受关闭思考或手动思考预算。",
      "routes": [
        { "id": "messages", "label": "Messages", "protocol": "anthropic-messages", "baseUrl": "https://api.anthropic.com", "authMode": "x-api-key",
          "dialect": { "autoCache": true }, "listModels": true }
      ]
    },
    {
      "id": "deepseek", "name": "DeepSeek", "kind": "vendor",
